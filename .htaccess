RewriteEngine On

# ==========================================
# CANONICAL URL: Force HTTPS + non-www
# ==========================================

# Redirect www to non-www (handles both HTTP and HTTPS)
RewriteCond %{HTTP_HOST} ^www\.rajsuyash\.com [NC]
RewriteRule ^(.*)$ https://rajsuyash.com/$1 [L,R=301]

# Force HTTPS (only for non-www now)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^rajsuyash\.com [NC]
RewriteRule ^(.*)$ https://rajsuyash.com/$1 [L,R=301]

# ==========================================
# REDIRECTS: Fix 404 errors
# ==========================================

# Blog post redirects (fix filename mismatches)
RewriteRule ^blog/accounting-ai-automation\.html$ /blog/accounting-firms-ai-document-automation.html [R=301,L]
RewriteRule ^blog/law-firm-ai-client-intake\.html$ /blog/law-firms-ai-client-intake.html [R=301,L]
RewriteRule ^blog/real-estate-ai-lead-response\.html$ /blog/real-estate-ai-automation-case-study.html [R=301,L]
RewriteRule ^blog/ai-voice-agent-vs-call-center\.html$ /blog/ai-voice-agent-vs-call-center-cost.html [R=301,L]

# Consolidated cannibalising posts (2026-09-17)
RewriteRule ^blog/ai-voice-agent-outbound-calls\.html$ /blog/ai-voice-agent-platform-comparison-2026.html [R=301,L]
RewriteRule ^blog/ai-automation-roadmap-where-to-start\.html$ /blog/ai-automation-strategy-smb-playbook.html [R=301,L]
RewriteRule ^blog/ai-automation-case-studies\.html$ /blog/real-estate-ai-automation-case-study.html [R=301,L]
RewriteRule ^blog/n8n-pipedrive-integration\.html$ /blog/n8n-sales-pipeline-automation.html [R=301,L]
RewriteRule ^blog/ai-voice-agent-law-firms\.html$ /blog/law-firms-ai-client-intake.html [R=301,L]
RewriteRule ^blog/ai-voice-agents-peak-season-customer-service\.html$ /blog/consumer-brand-call-center-scaling-peak-season.html [R=301,L]

# Section redirects
RewriteRule ^services/?$ /consulting.html [R=301,L]
RewriteRule ^about/?$ /about.html [R=301,L]
RewriteRule ^contact/?$ /qualify.html [R=301,L]

# Redirect /home and /home/ to homepage
RewriteRule ^home/?$ / [R=301,L]

# Redirect removed pages to homepage
RewriteRule ^testimonials-2/?$ / [R=301,L]
RewriteRule ^clawdbot-automation\.html$ / [R=301,L]
RewriteRule ^moltbot-automation\.html$ / [R=301,L]

# Block WordPress folder
RewriteRule ^wordpress/ - [F,L]
RewriteRule ^wp-.*\.php$ - [F,L]

# Consolidation 2026-09-18: product intent moves to voxdonna.com, agency page
# becomes /consulting.html. These must stay ABOVE the extension-cleanup rule
# below, which carries [L] and would otherwise terminate the round first.
RewriteRule ^ai-automation-agency\.html$ /consulting.html [R=301,L]
RewriteRule ^ai-automation-agency/?$ /consulting.html [R=301,L]
RewriteRule ^ai-voice-agent\.html$ https://voxdonna.com/ai-voice-agents.html [R=301,L]
RewriteRule ^ai-voice-agent/?$ https://voxdonna.com/ai-voice-agents.html [R=301,L]
RewriteRule ^ai-voice-agent-hubspot\.html$ https://voxdonna.com/ai-voice-agents.html [R=301,L]
RewriteRule ^ai-voice-agent-for-veterinary-clinics\.html$ https://voxdonna.com/ai-voice-agents.html [R=301,L]
RewriteRule ^ai-intake-for-law-firms\.html$ https://voxdonna.com/ai-voice-agents.html [R=301,L]
RewriteRule ^case-studies/le-marquier\.html$ https://voxdonna.com/case-studies/le-marquier.html [R=301,L]

# ==========================================
# URL CLEANUP: Remove .html extension
# ==========================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# ==========================================
# PERFORMANCE: Caching & Compression
# ==========================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|css|js|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>
